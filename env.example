# Add these in Railway > your web service > Variables.
# NEVER commit real values to GitHub.
PLAID_CLIENT_ID=your_client_id
PLAID_SECRET=your_rotated_secret
PLAID_ENV=sandbox
DATABASE_URL=provided_by_railway_postgres
NODE_ENV=production
# Optional: canonical HTTPS origin, without a trailing slash.
# APP_ORIGIN=https://your-existing-domain.up.railway.app
